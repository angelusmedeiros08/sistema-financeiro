# Copie para .env.local e preencha com os valores reais (nunca comitar
# .env.local — já está no .gitignore). Nenhum valor aqui é real.

# --- Públicas (expostas ao bundle do navegador, seguras por design) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=

# --- Supabase, privilegiada (nunca sai do servidor) ---
SUPABASE_SERVICE_ROLE_KEY=

# --- SMTP transacional (Brevo) ---
BREVO_SMTP_HOST=
BREVO_SMTP_USER=
BREVO_SMTP_PASSWORD=
BREVO_SENDER_EMAIL=

# --- Cron (autentica /api/cron/* — segredo compartilhado, não sessão de
# usuário). Gerar com: openssl rand -hex 32 (256 bits) ---
CRON_SECRET=

# --- Asaas (gateway de pagamento — checkout de assinatura) ---
ASAAS_API_KEY=
ASAAS_API_URL=

# --- Anthropic (Importar com IA) ---
ANTHROPIC_API_KEY=
